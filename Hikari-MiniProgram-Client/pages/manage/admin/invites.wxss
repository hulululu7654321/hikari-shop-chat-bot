page { background: #F8FAFC; }
.page { padding: 24rpx; min-height: 100vh; }

.gen-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-title { font-size: 28rpx; font-weight: bold; color: #1E293B; display: block; margin-bottom: 20rpx; }

.gen-row { display: flex; gap: 16rpx; align-items: flex-end; }
.gen-field { display: flex; flex-direction: column; gap: 8rpx; flex: 1; }
.gen-field.flex2 { flex: 2; }
.field-label { font-size: 24rpx; color: #94A3B8; }
.field-input {
  background: #F8FAFC;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1E293B;
  border: 2rpx solid #E2E8F0;
}
.gen-btn {
  padding: 18rpx 28rpx;
  background: #07C160;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  white-space: nowrap;
}
.gen-btn.disabled { background: #94A3B8; }

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.filter-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #475569;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.arrow { color: #94A3B8; font-size: 22rpx; }
.list-count { font-size: 24rpx; color: #94A3B8; }

.loading-tip, .empty-tip { text-align: center; padding: 60rpx; color: #94A3B8; font-size: 28rpx; }

.invite-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.invite-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.invite-code { font-size: 30rpx; font-weight: bold; color: #1E293B; font-family: monospace; }
.invite-status { font-size: 24rpx; font-weight: bold; padding: 4rpx 16rpx; border-radius: 8rpx; }
.invite-status.unused  { color: #07C160; background: rgba(7,193,96,0.1); }
.invite-status.used    { color: #94A3B8; background: #F1F5F9; }
.invite-status.revoked { color: #EF4444; background: rgba(239,68,68,0.08); }
.invite-meta { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #94A3B8; margin-top: 6rpx; }
.invite-note { color: #64748B; }
.revoke-btn {
  font-size: 24rpx;
  color: #EF4444;
  padding: 4rpx 16rpx;
  border: 2rpx solid rgba(239,68,68,0.3);
  border-radius: 8rpx;
}

page { background: #F8FAFC; }
.page { padding: 24rpx; min-height: 100vh; }

/* 统计卡片 */
.stats-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.stats-loading { text-align: center; color: #94A3B8; font-size: 26rpx; padding: 16rpx 0; }
.stats-row { display: flex; justify-content: space-around; align-items: center; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-num { font-size: 40rpx; font-weight: bold; color: #07C160; }
.stat-label { font-size: 22rpx; color: #94A3B8; }
.stat-divider { width: 2rpx; height: 48rpx; background: #E2E8F0; }

/* 功能菜单网格 */
.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.menu-icon  { font-size: 48rpx; }
.menu-title { font-size: 30rpx; font-weight: bold; color: #1E293B; }
.menu-desc  { font-size: 22rpx; color: #94A3B8; line-height: 1.4; }

/* 快捷下单 */
.quick-row {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.quick-icon { font-size: 48rpx; }
.quick-info { flex: 1; }
.quick-title { font-size: 30rpx; font-weight: bold; color: #1E293B; display: block; margin-bottom: 6rpx; }
.quick-desc  { font-size: 24rpx; color: #94A3B8; display: block; }
.quick-arrow { font-size: 36rpx; color: #CBD5E1; }

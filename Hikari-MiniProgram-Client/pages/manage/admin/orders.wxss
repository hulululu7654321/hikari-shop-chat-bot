page { background: #F8FAFC; }
.page { padding: 24rpx; min-height: 100vh; }
.filter-bar { display: flex; gap: 12rpx; margin-bottom: 16rpx; align-items: center; }
.filter-input { flex: 1; background: #fff; border-radius: 10rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: #1E293B; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04); }
.date-input { max-width: 240rpx; flex: none; }
.store-picker { flex: 1; }
.store-picker-inner { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 10rpx; padding: 16rpx 20rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04); }
.store-picker-text { font-size: 26rpx; color: #1E293B; }
.store-picker-arrow { font-size: 20rpx; color: #94A3B8; }
.search-btn { padding: 16rpx 28rpx; background: #07C160; border-radius: 10rpx; color: #fff; font-size: 26rpx; font-weight: bold; white-space: nowrap; }
.list-count { font-size: 24rpx; color: #94A3B8; display: block; margin-bottom: 16rpx; }
.loading-tip, .empty-tip { text-align: center; padding: 80rpx; color: #CBD5E1; font-size: 28rpx; }
.order-card { background: #fff; border-radius: 16rpx; padding: 24rpx 32rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.order-top { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.order-pkg   { font-size: 30rpx; font-weight: bold; color: #1E293B; }
.order-price { font-size: 30rpx; font-weight: bold; color: #07C160; }
.order-mid   { display: flex; gap: 12rpx; align-items: center; margin-bottom: 10rpx; }
.tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.tag.green  { background: rgba(7,193,96,0.1);   color: #07C160; }
.tag.purple { background: rgba(99,102,241,0.1); color: #6366f1; }
.order-store { font-size: 22rpx; color: #94A3B8; }
.order-bottom { display: flex; gap: 16rpx; flex-wrap: wrap; }
.order-time { font-size: 24rpx; color: #94A3B8; }
.order-pay  { font-size: 24rpx; color: #64748B; }
.order-note { font-size: 24rpx; color: #94A3B8; }
.order-buyer { font-size: 24rpx; color: #6366f1; margin-left: auto; }

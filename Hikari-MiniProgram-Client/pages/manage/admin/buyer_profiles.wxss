/* pages/manage/admin/buyer_profiles.wxss — 买家画像页样式
   风格对齐 packages.wxss / users.wxss（无第三方 UI 库，原生小程序）
*/

.page {
  background: #F5F5F7;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 套餐信息头 ── */
.pkg-header {
  background: #fff;
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 20rpx;
}
.pkg-header-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.pkg-header-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.pkg-header-type {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
}
.pkg-header-type.online {
  background: #EDE9FE;
  color: #6D28D9;
}
.pkg-header-type.store {
  background: #D1FAE5;
  color: #065F46;
}
.pkg-header-sub {
  font-size: 24rpx;
  color: #888;
}

/* ── 通用状态 ── */
.loading-tip,
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* ── Section ── */
.section {
  background: #fff;
  margin: 0 0 20rpx;
  padding: 0 0 16rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.buyer-count {
  font-size: 24rpx;
  color: #6366F1;
  font-weight: 500;
}

/* ── 表格 ── */
.table-scroll {
  width: 100%;
}
.table {
  min-width: 900rpx;   /* 横向滚动最小宽度 */
  padding: 0 16rpx;
}
.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.table-row:last-child {
  border-bottom: none;
}
.table-head {
  background: #FAFAFA;
  border-radius: 8rpx;
  margin-bottom: 4rpx;
}
.table-head text {
  font-size: 22rpx;
  color: #888;
  font-weight: 600;
}
.row-alt {
  background: #FAFAFA;
}

/* 列宽 */
.col-idx   { width: 56rpx;  text-align: center; font-size: 24rpx; color: #999; flex-shrink: 0; }
.col-name  { width: 160rpx; font-size: 26rpx; color: #1A1A1A; font-weight: 500; flex-shrink: 0;
             overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-vip   { width: 80rpx;  text-align: center; font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.col-num   { width: 80rpx;  text-align: center; font-size: 24rpx; color: #555; flex-shrink: 0; }
.col-money { width: 100rpx; text-align: right;  font-size: 24rpx; color: #10B981; font-weight: 500; flex-shrink: 0; }
.col-time  { flex: 1; text-align: right; font-size: 22rpx; color: #999; }

/* VIP 颜色 */
.vip-1 { color: #6366F1; }
.vip-2 { color: #F59E0B; }

/* ── 加载更多 ── */
.load-more-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* ── 导出区域 ── */
.export-section {
  background: #fff;
  margin: 0;
  padding: 32rpx;
  border-top: 1rpx solid #F0F0F0;
}
.export-desc {
  margin-bottom: 24rpx;
}
.export-desc-text {
  display: block;
  font-size: 26rpx;
  color: #444;
  margin-bottom: 8rpx;
}
.export-desc-sub {
  font-size: 22rpx;
  color: #999;
}
.export-btn {
  background: #6366F1;
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.export-btn.btn-loading {
  background: #A5B4FC;
}

/* 导出结果 */
.export-result {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #F0FDF4;
  border-radius: 10rpx;
  border: 1rpx solid #D1FAE5;
}
.export-result-info { margin-bottom: 16rpx; }
.export-result-label {
  font-size: 24rpx;
  color: #6B7280;
}
.export-result-file {
  display: block;
  font-size: 24rpx;
  color: #065F46;
  margin-top: 8rpx;
  word-break: break-all;
}
.export-result-actions {
  display: flex;
  gap: 16rpx;
}
.open-btn {
  flex: 1;
  padding: 14rpx 0;
  background: #6366F1;
  color: #fff;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reexport-btn {
  padding: 14rpx 28rpx;
  background: #F1F5F9;
  color: #64748B;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

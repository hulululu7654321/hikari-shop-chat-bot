<view class="page">
  <view class="stats-card">
    <view wx:if="{{statsLoading}}" class="stats-loading">
      <text>加载中…</text>
    </view>
    <view wx:elif="{{stats}}" class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{stats.users.total}}</text>
        <text class="stat-label">总用户</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.users.with_access}}</text>
        <text class="stat-label">已激活</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.users.vip}}</text>
        <text class="stat-label">VIP</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.orders.today}}</text>
        <text class="stat-label">今日订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.invite_codes.unused}}</text>
        <text class="stat-label">邀请码</text>
      </view>
    </view>
    <view wx:else class="stats-loading">
      <text>暂无数据</text>
    </view>
  </view>

  <view class="menu-grid">
    <view wx:for="{{menus}}" wx:key="key" class="menu-item" bindtap="goMenu" data-key="{{item.key}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="quick-row" bindtap="goStore">
    <text class="quick-icon">🏪</text>
    <view class="quick-info">
      <text class="quick-title">到店下单</text>
      <text class="quick-desc">进入店员界面，为在店客户下到店套餐</text>
    </view>
    <text class="quick-arrow">›</text>
  </view>
</view>

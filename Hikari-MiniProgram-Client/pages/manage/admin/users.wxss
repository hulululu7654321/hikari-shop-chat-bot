page { background: #F8FAFC; }
.page { padding: 24rpx; min-height: 100vh; }

/* 搜索框 */
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1E293B;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.search-btn {
  padding: 20rpx 36rpx;
  background: #1AAD19;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}
.search-btn.loading { background: #94A3B8; }

/* 搜索结果 */
.result-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.result-name-row { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 6rpx; }
.result-name { font-size: 30rpx; font-weight: bold; color: #1E293B; max-width: 280rpx; overflow: hidden; text-overflow: ellipsis; }
.result-uid  { font-size: 22rpx; color: #CBD5E1; font-family: monospace; }
.result-meta { font-size: 24rpx; color: #94A3B8; }
.result-arrow { font-size: 32rpx; color: #CBD5E1; }

/* 详情 */
.loading-tip { text-align: center; padding: 60rpx; color: #94A3B8; font-size: 28rpx; }

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.back-btn { font-size: 28rpx; color: #1AAD19; padding: 8rpx 0; }
.detail-name { font-size: 34rpx; font-weight: bold; color: #1E293B; }

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-title { font-size: 26rpx; color: #64748B; font-weight: bold; display: block; margin-bottom: 16rpx; }
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F8FAFC;
}
.info-row:last-child { border-bottom: none; }
.info-key { font-size: 26rpx; color: #94A3B8; }
.info-val { font-size: 26rpx; color: #1E293B; }
.info-val.green { color: #1AAD19; font-weight: bold; }
.info-val.red   { color: #EF4444; }

.mini-order { display: flex; gap: 16rpx; padding: 10rpx 0; font-size: 24rpx; color: #64748B; }
.mini-order-name  { flex: 1; }
.mini-order-price { color: #1AAD19; font-weight: bold; }
.mini-order-time  { color: #94A3B8; }

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}
.action-btn.green { background: #1AAD19; }
.action-btn.gray  { background: #94A3B8; }
.action-btn.red   { background: #EF4444; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  width: 560rpx;
}
.modal-title { font-size: 34rpx; font-weight: bold; color: #1E293B; display: block; margin-bottom: 32rpx; }
.modal-form  { margin-bottom: 32rpx; }
.form-label  { font-size: 26rpx; color: #64748B; display: block; margin-bottom: 12rpx; }
.form-label.mt { margin-top: 24rpx; }
.picker-row  { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 30rpx; color: #1E293B; border-bottom: 2rpx solid #E2E8F0; }
.arrow { color: #94A3B8; }
.modal-input {
  width: 100%;
  border-bottom: 2rpx solid #E2E8F0;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #1E293B;
}
.modal-btns { display: flex; gap: 16rpx; }
.modal-btn  { flex: 1; height: 88rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: bold; }
.modal-btn.cancel  { background: #F1F5F9; color: #64748B; }
.modal-btn.confirm { background: #1AAD19; color: #fff; }

/* 激活状态筛选器 */
.filter-bar {
  margin-bottom: 20rpx;
}
.filter-picker {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.filter-label {
  font-size: 26rpx;
  color: #1E293B;
}

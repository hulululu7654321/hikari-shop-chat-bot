page { background: #F8FAFC; }
.page { padding: 24rpx; min-height: 100vh; }
.loading-tip, .empty-tip { text-align: center; padding: 80rpx; color: #CBD5E1; font-size: 28rpx; }
.store-card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.store-name { font-size: 32rpx; font-weight: bold; color: #1E293B; display: block; margin-bottom: 16rpx; }
.url-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.store-url { font-size: 22rpx; color: #6366f1; word-break: break-all; flex: 1; }
.copy-hint { font-size: 22rpx; color: #94A3B8; margin-left: 12rpx; flex-shrink: 0; }
.meta-row { display: flex; gap: 24rpx; margin-bottom: 20rpx; }
.meta { font-size: 24rpx; color: #94A3B8; }
.reset-btn { padding: 18rpx 0; background: rgba(239,68,68,0.08); border-radius: 12rpx; text-align: center; font-size: 28rpx; color: #EF4444; font-weight: bold; }
.reset-btn.loading { background: #F1F5F9; color: #94A3B8; }

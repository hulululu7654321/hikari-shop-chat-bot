page { background: #F8FAFC; }
.page { padding: 24rpx; min-height: 100vh; }
.search-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.search-input { flex:1; background:#fff; border-radius:12rpx; padding:20rpx 24rpx; font-size:28rpx; color:#1E293B; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.search-btn { padding:20rpx 32rpx; background:#1AAD19; border-radius:12rpx; color:#fff; font-size:28rpx; font-weight:bold; }
.search-results { background:#fff; border-radius:16rpx; margin-bottom:20rpx; overflow:hidden; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.search-item { display:flex; justify-content:space-between; padding:24rpx 32rpx; border-bottom:2rpx solid #F8FAFC; }
.search-item:last-child { border-bottom:none; }
.s-name { font-size:28rpx; color:#1E293B; }
.s-hint { font-size:26rpx; color:#1AAD19; }
.section-title { font-size:26rpx; font-weight:bold; color:#64748B; display:block; margin-bottom:16rpx; }
.loading-tip, .empty-tip { text-align:center; padding:60rpx; color:#CBD5E1; font-size:28rpx; }
.role-card { background:#fff; border-radius:16rpx; padding:24rpx 32rpx; margin-bottom:16rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.role-info { display:flex; align-items:center; gap:14rpx; flex-wrap:wrap; margin-bottom:10rpx; }
.role-name { font-size:30rpx; font-weight:bold; color:#1E293B; max-width:300rpx; overflow:hidden; text-overflow:ellipsis; }
.role-badge { font-size:22rpx; padding:3rpx 14rpx; border-radius:8rpx; font-weight:bold; }
.role-badge.admin { background:rgba(239,68,68,0.1); color:#EF4444; }
.role-badge.store_clerk { background:rgba(7,193,96,0.1); color:#1AAD19; }
.role-store { font-size:24rpx; color:#94A3B8; }
.role-meta { font-size:24rpx; color:#94A3B8; margin-bottom:16rpx; }
.revoke-btn { text-align:center; padding:14rpx; background:rgba(239,68,68,0.06); border-radius:10rpx; font-size:26rpx; color:#EF4444; font-weight:bold; }
.modal-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.45); display:flex; align-items:center; justify-content:center; z-index:999; }
.modal-box { background:#fff; border-radius:24rpx; padding:48rpx 40rpx 36rpx; width:560rpx; }
.modal-title { font-size:34rpx; font-weight:bold; color:#1E293B; display:block; margin-bottom:32rpx; }
.form-row { margin-bottom:24rpx; }
.form-label { font-size:26rpx; color:#64748B; display:block; margin-bottom:10rpx; }
.picker-row { display:flex; justify-content:space-between; padding:12rpx 0; font-size:30rpx; color:#1E293B; border-bottom:2rpx solid #E2E8F0; }
.arrow { color:#94A3B8; }
.form-input { width:100%; border-bottom:2rpx solid #E2E8F0; padding:16rpx 0; font-size:30rpx; color:#1E293B; box-sizing:border-box; min-height:60rpx; max-height:80rpx; line-height:1.5; }
.modal-btns { display:flex; gap:16rpx; margin-top:32rpx; }
.modal-btn { flex:1; height:88rpx; border-radius:14rpx; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:bold; }
.modal-btn.cancel  { background:#F1F5F9; color:#64748B; }
.modal-btn.confirm { background:#1AAD19; color:#fff; }
.modal-btn.confirm.loading { background:#94A3B8; }

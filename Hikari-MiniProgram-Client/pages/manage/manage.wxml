<view class="manage-loading">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在验证权限喵…</text>
  </view>
  <view wx:elif="{{errMsg}}" class="err-wrap">
    <text class="err-icon">🔒</text>
    <text class="err-msg">{{errMsg}}</text>
    <view class="back-btn" bindtap="goBack">
      <text>返回</text>
    </view>
  </view>
</view>

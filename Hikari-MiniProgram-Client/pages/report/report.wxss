/* ── 报告页 — 弥散渐变玻璃风格，对齐 chat/shop 页 ── */

page {
  background: linear-gradient(145deg, #fce8f3 0%, #ede8ff 38%, #ddf0ff 68%, #e8faf0 100%);
  height: 100%;
}

.report-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 左上光晕 */
.report-page::before {
  content: '';
  position: fixed;
  top: -100rpx; left: -80rpx;
  width: 480rpx; height: 480rpx;
  background: radial-gradient(circle, rgba(255,182,213,0.45) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}
/* 右下光晕 */
.report-page::after {
  content: '';
  position: fixed;
  bottom: 80rpx; right: -80rpx;
  width: 560rpx; height: 560rpx;
  background: radial-gradient(circle, rgba(165,200,240,0.38) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}

/* ── 顶部标题栏 ── */
.tech-header {
  padding: 40rpx 32rpx 32rpx;
  background: transparent;
  border-bottom: none;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}
.tech-header .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #4b6a7e;
  display: block;
}
.tech-header .subtitle {
  font-size: 20rpx;
  color: #aad4e8;
  letter-spacing: 4rpx;
  margin-top: 10rpx;
  display: block;
}

/* ── 内容区 ── */
.content-scroll {
  flex: 1;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.markdown-body {
  padding: 24rpx 28rpx;
  line-height: 1.8;
  font-size: 30rpx;
  color: #4b6a7e;
  letter-spacing: 2rpx;
  white-space: pre-wrap;
}

/* 报告内容卡片：玻璃质感 */
.markdown-body text {
  display: block;
  background: rgba(255, 255, 255, 0.65);
  padding: 36rpx 36rpx 36rpx 44rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 4rpx 24rpx rgba(165,200,240,0.18), 0 1rpx 4rpx rgba(165,200,240,0.1);
  border-left: 6rpx solid #f9a8d4;
}

.bottom-pad { height: 160rpx; }

/* ── 底部按钮栏 ── */
.action-bar {
  position: fixed;
  bottom: 0; width: 100%;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: transparent;
  display: flex;
  box-sizing: border-box;
  justify-content: space-between;
  gap: 20rpx;
  z-index: 10;
}

.btn-copy, .btn-back {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-copy {
  background: linear-gradient(135deg, #f9a8d4 0%, #a5c8f0 55%, #bae6fd 100%);
  color: #fff;
  box-shadow: 0 6rpx 24rpx rgba(165,200,240,0.4);
}
.btn-back {
  background: rgba(255,255,255,0.60);
  color: #89aec8;
  border: 1rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 4rpx 16rpx rgba(165,200,240,0.15);
}

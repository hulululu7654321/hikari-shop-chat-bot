/* pages/invite/invite.wxss — 弥散渐变风格，对齐 chat/shop/index 页 */

page {
  background: linear-gradient(145deg, #fce8f3 0%, #ede8ff 38%, #ddf0ff 68%, #e8faf0 100%);
  height: 100%;
  margin: 0; padding: 0;
}

.invite-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 左上光晕 */
.invite-container::before {
  content: '';
  position: fixed;
  top: -120rpx; left: -80rpx;
  width: 520rpx; height: 520rpx;
  background: radial-gradient(circle, rgba(255,182,213,0.5) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}
/* 右下光晕 */
.invite-container::after {
  content: '';
  position: fixed;
  bottom: -60rpx; right: -100rpx;
  width: 600rpx; height: 600rpx;
  background: radial-gradient(circle, rgba(165,200,240,0.42) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}

/* 头像 */
.invite-logo { margin-bottom: 48rpx; position: relative; z-index: 1; }
.invite-avatar {
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 32rpx rgba(165,200,240,0.4);
}

/* 标题 */
.invite-title {
  font-size: 52rpx; font-weight: bold;
  color: #4b6a7e;
  margin-bottom: 20rpx;
  letter-spacing: 4px;
  position: relative; z-index: 1;
}

/* 副标题 */
.invite-sub {
  font-size: 28rpx; color: #89aec8;
  margin-bottom: 80rpx;
  text-align: center; line-height: 1.7;
  padding: 0 20rpx;
  position: relative; z-index: 1;
}

/* 表单区 */
.invite-form { width: 100%; margin-bottom: 0; position: relative; z-index: 1; }

.invite-input-wrap {
  width: 100%;
  background: rgba(255,255,255,0.65);
  border: 1rpx solid rgba(255,255,255,0.9);
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  height: 100rpx;
  display: flex; align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(165,200,240,0.18);
}
.invite-input-wrap.input-error {
  border-color: rgba(248,113,113,0.5);
  background: rgba(255,240,240,0.6);
}

.invite-input {
  width: 100%; height: 100%;
  font-size: 30rpx; color: #4b6a7e;
  background: transparent; border: none;
  padding: 0; margin: 0;
}

.invite-err { margin-top: 14rpx; padding-left: 8rpx; position: relative; z-index: 1; }
.invite-err-text { font-size: 26rpx; color: #f87171; }

/* 激活按钮 */
.invite-btn {
  width: 100%;
  border-radius: 50rpx;
  height: 100rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: bold;
  margin-top: 32rpx;
  position: relative; z-index: 1;
}
.btn-active {
  background: linear-gradient(135deg, #f9a8d4 0%, #a5c8f0 55%, #bae6fd 100%);
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(165,200,240,0.45);
}
.btn-disabled {
  background: rgba(255,255,255,0.45);
  color: #aad4e8;
}

/* 底部提示 */
.invite-hint {
  margin-top: 60rpx;
  font-size: 26rpx; color: #aad4e8;
  text-align: center;
  position: relative; z-index: 1;
}

/* 宽限期到期提示 */
.expired-hint {
  display: flex; flex-direction: column; align-items: center;
  margin: 40rpx 0 60rpx;
  padding: 40rpx;
  background: rgba(255,255,255,0.55);
  border: 1rpx solid rgba(255,255,255,0.85);
  border-radius: 24rpx;
  width: 100%; box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(165,200,240,0.15);
  position: relative; z-index: 1;
}
.expired-icon { font-size: 64rpx; margin-bottom: 20rpx; }
.expired-text { font-size: 28rpx; color: #89aec8; text-align: center; line-height: 1.6; }

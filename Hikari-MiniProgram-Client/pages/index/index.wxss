/* pages/index/index.wxss — 弥散渐变启动页 */

page {
  height: 100%;
  background: linear-gradient(145deg, #fce8f3 0%, #ede8ff 38%, #ddf0ff 68%, #e8faf0 100%);
}

.gateway-container {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 左上光晕 */
.gateway-container::before {
  content: '';
  position: fixed;
  top: -120rpx; left: -80rpx;
  width: 520rpx; height: 520rpx;
  background: radial-gradient(circle, rgba(255,182,213,0.55) 0%, transparent 70%);
  pointer-events: none;
}
/* 右下光晕 */
.gateway-container::after {
  content: '';
  position: fixed;
  bottom: -60rpx; right: -100rpx;
  width: 600rpx; height: 600rpx;
  background: radial-gradient(circle, rgba(165,200,240,0.45) 0%, transparent 70%);
  pointer-events: none;
}

/* 中间玻璃卡片 */
.status-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
  position: relative;
  z-index: 1;
}

/* 头像 */
.gateway-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 32rpx rgba(165,200,240,0.4);
  margin-bottom: 48rpx;
}

.status-text {
  margin-top: 40rpx;
  font-size: 36rpx;
  color: #7eb8d4;
  font-weight: 500;
  letter-spacing: 2px;
}

/* 加载环：粉蓝渐变色 */
.loading-ring {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(165,200,240,0.2);
  border-top-color: #f9a8d4;
  border-right-color: #a5c8f0;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
